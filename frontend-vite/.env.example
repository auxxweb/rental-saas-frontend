# Copy to `.env` or `.env.local` (not committed). Only prefixed vars are exposed to the client.

# Public API base URL (must include `/api` path).
#
# Dev default (when unset): `/api` — same-origin via Vite proxy (recommended; avoids CORS login issues).
#
# Option A — explicit proxy (same as default in dev):
# VITE_API_URL=/api
#
# Option B — call backend directly (must allow CORS from `http://localhost:5173`):
VITE_API_URL=http://localhost:5000/api

# Optional: Vite dev/preview proxy target — **origin only** (no `/api` suffix).
# Example: http://localhost:5000  or  https://api.yourdomain.com
# If you paste `.../api` by mistake, it is stripped so `/api/global-settings` does not become `/api/api/...` (404).
# VITE_DEV_PROXY_TARGET=http://localhost:5000
